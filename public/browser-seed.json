ation?\n- Where does Linux keep configuration files?\n- How can I tell what is using my memory?\n"},"revision":1,"deleted":false,"created":"2026-10-07T10:49:39.044Z","updated":"2026-10-07T10:49:39.044Z"},{"id":"ad7fc864-a579-4f6f-acb1-8a9bce415d81","kind":"notebook","parent":null,"project":null,"title":"Ideas in motion","data":{"icon":"↗","cover":"night","description":"The beginnings of something good.","access":false},"revision":1,"deleted":false,"created":"2026-10-07T10:49:39.046Z","updated":"2026-10-07T10:49:39.046Z"},{"id":"b40d34bd-38a3-41c1-b6e3-06037dc44d5e","kind":"notebook","parent":null,"project":null,"title":"Everyday rituals","data":{"icon":"☼","cover":"day","description":"Useful routines for a calmer desktop.","access":false},"revision":1,"deleted":false,"created":"2026-10-07T10:49:39.048Z","updated":"2026-10-07T10:49:39.048Z"},{"id":"e7b28519-e562-4dd0-86cc-2dd6fbebc0fd","kind":"board","parent":null,"project":null,"title":"A little progress","data":{"description":"Turn a good intention into a next step.","access":true,"permission":"edit","assigned":false},"revision":1,"deleted":false,"created":"2026-10-07T10:49:39.051Z","updated":"2026-10-07T10:49:39.051Z"},{"id":"bb023d08-d562-4763-9e4f-a11c7ca5b214","kind":"list","parent":"e7b28519-e562-4dd0-86cc-2dd6fbebc0fd","project":null,"title":"To explore","data":{},"revision":1,"deleted":false,"created":"2026-10-07T10:49:39.054Z","updated":"2026-10-07T10:49:39.054Z"},{"id":"78f53630-ca8b-430b-a85f-2b49916c2f5c","kind":"list","parent":"e7b28519-e562-4dd0-86cc-2dd6fbebc0fd","project":null,"title":"In progress","data":{},"revision":1,"deleted":false,"created":"2026-10-07T10:49:39.056Z","updated":"2026-10-07T10:49:39.056Z"},{"id":"08cee59e-5f48-4443-ae78-b9a4f412f6c3","kind":"list","parent":"e7b28519-e562-4dd0-86cc-2dd6fbebc0fd","project":null,"title":"Done","data":{},"revision":1,"deleted":false,"created":"2026-10-07T10:49:39.058Z","updated":"2026-10-07T10:49:39.058Z"},{"id":"d4ff2321-ecfb-4f36-b17f-933b1ee02b42"